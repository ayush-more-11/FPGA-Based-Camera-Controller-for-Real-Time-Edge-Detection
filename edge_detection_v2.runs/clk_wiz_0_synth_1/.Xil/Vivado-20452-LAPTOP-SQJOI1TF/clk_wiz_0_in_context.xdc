create_clock -period 20.000 [get_ports {clk_in1}]
create_generated_clock -source [get_ports -no_traverse clk_in1] -edges {1 2 3} -edge_shift {0.000 10.000 20.000} [get_ports -no_traverse {clk_25MHz}]
create_generated_clock -source [get_ports -no_traverse clk_in1] -edges {1 2 3} -edge_shift {0.000 10.833 21.667} [get_ports -no_traverse {clk_24MHz}]
create_generated_clock -source [get_ports -no_traverse clk_in1] -edges {1 2 3} -edge_shift {0.000 -5.000 -10.000} [get_ports -no_traverse {clk_100MHz}]
create_generated_clock -source [get_ports -no_traverse clk_in1] -edges {1 2 3} -edge_shift {5.000 0.000 -5.000} [get_ports -no_traverse {clk_100MHz_shift}]
set_property -quiet IO_BUFFER_TYPE NONE [get_ports -quiet clk_in1]
set_property -quiet CLOCK_BUFFER_TYPE NONE [get_ports -quiet clk_in1]
set_property -quiet IS_IP_OOC_CELL TRUE [get_cells -of [get_ports -no_traverse -quiet clk_100MHz]]
